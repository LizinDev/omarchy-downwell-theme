{
  "manifest_version": 3,
  "name": "Downwell Gunboots",
  "description": "Companion of the Downwell Omarchy theme: a title-screen new tab page, a pause-menu popup, a shop side panel for bookmarks, history and downloads, the game's scrollbars, cursors, selection and focus rings on every site, and its death screen for pages that fail to load.",
  "version": "1.2.0",
  "version_name": "unset",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage", "alarms", "management", "topSites", "favicon", "search", "scripting", "notifications",
    "sidePanel", "bookmarks", "history", "downloads", "downloads.open", "offscreen", "webNavigation", "tabGroups"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Downwell",
    "default_icon": { "16": "art/icon-16.png", "32": "art/icon-32.png", "48": "art/icon-48.png" }
  },
  "commands": {
    "open-shop": { "description": "Open the shop: bookmarks, history and downloads" }
  },
  "web_accessible_resources": [{ "resources": ["art/page-*.png"], "matches": ["<all_urls>"] }],
  "icons": { "16": "art/icon-16.png", "32": "art/icon-32.png", "48": "art/icon-48.png", "128": "art/icon-128.png" }
}
