#!/bin/bash
# Remove the theme color Omarchy writes into Chromium-family managed policy
# (color.json), so the current theme's Chromium theme extension can apply.
# Omarchy writes it again on the next theme set.
#
# tools/chromium-setup installs this root-owned as
# /usr/local/bin/browser-theme-policy-clear, with a sudoers rule that allows
# exactly that path with no arguments. It touches nothing but color.json in
# Omarchy's four fixed policy folders.

set -euo pipefail
export PATH=/usr/bin:/bin

if (( $# != 0 )); then
  echo "usage: browser-theme-policy-clear" >&2
  exit 2
fi

if (( EUID != 0 )); then
  echo "browser-theme-policy-clear: run it through sudo" >&2
  exit 1
fi

for dir in /etc/chromium/policies/managed /etc/opt/chrome/policies/managed \
  /etc/opt/edge/policies/managed /etc/brave/policies/managed; do
  [[ -d $dir && ! -L $dir ]] || continue
  if [[ -f $dir/color.json || -L $dir/color.json ]]; then
    rm -f -- "$dir/color.json"
  fi
done
